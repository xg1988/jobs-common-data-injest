# 공공데이터포털 인증키.
# 포털은 "Encoding" 키와 "Decoding" 키를 둘 다 발급합니다.
# 여기에는 둘 중 아무거나 넣어도 됩니다 -- ingest/sources/molit_apt_trade.py 의
# _normalize_service_key() 가 % 포함 여부로 판별해 알아서 맞춥니다.
DATA_GO_KR_KEY=

# --- DB (PostgREST) ---------------------------------------------------------
# 없으면 DB 쓰기를 건너뛰고 파일 저장만 합니다.
# 이 키는 RLS 를 우회하는 관리자 키입니다. 절대 공개하지 마세요.
#
# VPS 에서 직접 돌릴 때 (docs/VPS_DB.md):
#   DB_API_URL=http://127.0.0.1:3000     # 같은 서버면 밖으로 안 나갑니다
#   DB_API_KEY=<postgrest JWT>
DB_API_URL=
DB_API_KEY=

# 예전 이름 (Supabase). 위가 비어 있으면 이쪽을 봅니다.
# Supabase 대시보드 -> Project Settings -> API -> service_role
SUPABASE_URL=https://hmsyfipqrvdfitzmuaph.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
